# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/

# run outputs (reproducible)
logs/*
!logs/.gitkeep
logs-up.txt
results/

# temporary files of the documentation build
docs/**/*.pdf.tmp

# local deployment files (real addresses, model paths, ...)
deploy/cloud/site-stack/.env
deploy/cloud/site-stack/scenario.yaml
deploy/cloud/site-stack/endpoints.yaml
deploy/cloud/control-stack/.env
deploy/cloud/control-stack/scenario.yaml
deploy/cloud/control-stack/endpoints.yaml

# secrets and credentials
*.pem
.env
api_key*.txt
*token*.txt
hugging_face.txt
hf_token*

# editors
.vscode/
.idea/
.DS_Store

# scenario generated by the smoke test
**/.scenario.smoke.yaml

# synthetic workload generated by the tests
tests/data/datasets/workload-synthetic/
