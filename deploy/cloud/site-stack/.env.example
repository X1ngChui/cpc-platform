# 本服务器扮演的站点 id（必须与 scenario.yaml 中某个 sites[].id 一致）
SITE_ID=gz
# 模型（Hugging Face 仓库名）；国内服务器可设置 HF_ENDPOINT=https://hf-mirror.com，或改用 ModelScope
MODEL=Qwen/Qwen2.5-7B-Instruct
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=32
HF_CACHE=~/.cache/huggingface
HF_ENDPOINT=https://huggingface.co
VLLM_USE_MODELSCOPE=False
# 镜像版本建议固定，便于复现
VLLM_TAG=latest
CPC_IMAGE=cpc-platform:latest
