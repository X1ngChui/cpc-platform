# site id of this server (one of sites[].id in scenario.yaml)
SITE_ID=gz
# grid-signal service of the control node: the site agent fetches the scenario and addresses from it
CONTROL_URL=http://<control-node-ip>:9000
# model (Hugging Face repository); in mainland China set HF_ENDPOINT=https://hf-mirror.com or use ModelScope
MODEL=Qwen/Qwen2.5-7B-Instruct
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=32
HF_CACHE=~/.cache/huggingface
HF_ENDPOINT=https://huggingface.co
VLLM_USE_MODELSCOPE=False
# admin token, identical on all servers and the control stack (python -c "import secrets;print(secrets.token_hex(16))")
CPC_ADMIN_TOKEN=
# pin the image version for reproducibility
VLLM_TAG=latest
CPC_IMAGE=cpc-platform:latest
