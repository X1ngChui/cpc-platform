<mxfile host="cpc-docs"><diagram id="server-states" name="server-states"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="off&#xa;关机" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=14;html=0;ellipse;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#333333;strokeWidth=1.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="110" height="64" as="geometry"/></mxCell><mxCell id="c4" value="booting&#xa;启动中" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=14;html=0;ellipse;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#333333;strokeWidth=1.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="20" width="120" height="64" as="geometry"/></mxCell><mxCell id="c5" value="on&#xa;在线" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=14;html=0;ellipse;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#333333;strokeWidth=1.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="110" height="64" as="geometry"/></mxCell><mxCell id="c6" value="draining&#xa;排空中" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=14;html=0;ellipse;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="210" width="120" height="64" as="geometry"/></mxCell><mxCell id="c7" value="开机（power_on）" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=12;html=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="75" y="52"/></Array></mxGeometry></mxCell><mxCell id="c8" value="启动完成&#xa;（仿真：boot_s 后；&#xa;实验：就绪检查）" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=12;html=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525" y="52"/></Array><mxPoint x="0" y="-26" as="offset"/></mxGeometry></mxCell><mxCell id="c9" value="取消或开机失败" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=12;html=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=4 3;exitX=0.25;exitY=0.95;exitDx=0;exitDy=0;entryX=0.75;entryY=0.05;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="缩容，有在服务请求" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=12;html=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525" y="242"/></Array></mxGeometry></mxCell><mxCell id="c11" value="最后一个请求完成&#xa;（power_off）" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=12;html=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="75" y="242"/></Array></mxGeometry></mxCell><mxCell id="c12" value="扩容（无需重启）" style="fontFamily=Noto Sans SC;fontColor=#000000;fontSize=12;html